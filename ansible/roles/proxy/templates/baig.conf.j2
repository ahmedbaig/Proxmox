# Gatus on the Oracle box, proxied so it gets the real certificate.
#
# Previously an AdGuard rewrite sent oracle.baig.network straight to
# 158.178.143.215, which meant plain http:// in the browser. That is why its card
# on the service register carries data-nocheck: an http:// fetch from an https://
# page is mixed content and the status dot could never succeed.
#
# UPSTREAM IS PLAIN HTTP, OVER THE INTERNET. Oracle has no TLS listener -- :443 is
# closed -- and there is no route from here into the WireGuard tunnel:
# `ip route get 10.9.0.3` goes out the default gateway, and Oracle's own firewall
# blocks wg0 inbound anyway. So browser -> nginx is encrypted and nginx -> Oracle
# is not. No worse than before, when the browser went direct over http, but it is not
# the full win that a padlock implies. Giving Oracle a certificate, or opening the
# tunnel the other way, would close it.
#
# CAVEAT WORTH REMEMBERING: this puts the watchdog behind the thing it watches.
# Gatus answers "is the lab reachable from outside?", and reaching it through this
# proxy means that when the lab is down the dashboard is too. Telegram still
# alerts, and http://158.178.143.215/ still works directly -- use that when the
# house is on fire.
server {
    listen 443 ssl;
    http2 on;
    server_name oracle.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    include /etc/nginx/snippets/sso-auth.conf;
    location / {
        proxy_pass http://158.178.143.215:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Crossing the internet, so be less patient than for a LAN upstream and do
        # not let a hung Oracle hold a worker open.
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}

# GS724T switch UI, proxied so it can be reached over HTTPS.
#
# The switch speaks HTTP only -- :443 is closed and it has no way to get a
# certificate -- so the name previously had to be used as http://, which modern
# browsers upgrade to https:// on a typed hostname and then fail. Resolving the
# same name to this proxy instead means the browser gets the real wildcard
# certificate (*.main.baig.network covers it) and nginx does the plain-HTTP hop
# on the LAN.
#
# That hop is permitted by the `Servers -> Main Net mgmt` UniFi policy, which
# allows 22/80/443 to 192.168.0.3, .91 and .119 only. If this starts returning
# 502, check that policy before suspecting the switch.
#
# The UI is an old frame-based one but every reference is root-relative
# (/base/style.css, /base/js/...) with no absolute URLs, and it accepts a
# rewritten Host, so it proxies without path rewriting.
server {
    listen 443 ssl;
    http2 on;
    server_name netgear.main.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    location / {
        proxy_pass http://192.168.0.119:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        # Embedded web servers on switches are slow and easily upset by keepalive
        # and buffering; keep it simple and patient enough for a config save.
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# The apex, baig.network, redirected to the service register.
#
# It had no server block, so it fell to the catch-all and returned 444. Nothing
# depends on HTTP to the apex: WireGuard peers dial baig.network:51820 over UDP,
# and Gatus checks the public A record through DNS rather than fetching it. So
# this is free to redirect.
#
# 302, not 301. A 301 is cached by the browser indefinitely, so if a real vhost is
# ever wanted on the apex every device that visited once would keep redirecting and
# need its cache cleared by hand.
server {
    listen 443 ssl;
    http2 on;
    server_name baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;

    # `if` is only safe here because the block contains nothing but return --
    # that is the documented exception to "if is evil".
    if ($lab_client) {
        return 302 https://home.baig.network/;
    }
    return 444;
}

# Lab GitLab (CT 118) — git over HTTPS, web UI, large pushes. SSH clones go
# straight to gitlab.lab.baig.network:22, not through here.
server {
    listen 443 ssl;
    http2 on;
    server_name gitlab.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    client_max_body_size 0;
    location / {
        proxy_pass https://10.10.50.40;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_verify off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

# Lab Docker registry (CT 119) — image layers can be hundreds of MB, so no body
# limit and no buffering. Machines on the Lab VLAN use registry.lab.baig.network.
server {
    listen 443 ssl;
    http2 on;
    server_name registry.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    client_max_body_size 0;
    chunked_transfer_encoding on;
    # Browsers opening the bare host land on the web UI; docker only uses /v2/.
    location = / {
        return 302 https://registry-ui.baig.network/;
    }
    location / {
        proxy_pass https://10.10.50.41;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

# Lab registry web UI (CT 119, joxit/docker-registry-ui) — browse and delete
# images; login is the registry's own (user lab).
server {
    listen 443 ssl;
    http2 on;
    server_name registry-ui.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    include /etc/nginx/snippets/sso-auth.conf;
    location / {
        proxy_pass http://10.10.50.41:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_connect_timeout 60s;
        proxy_read_timeout 300s;
    }
}

