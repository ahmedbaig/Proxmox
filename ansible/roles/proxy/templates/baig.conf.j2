# UniFi gateway (UX7) — the router's own UI, behind the wildcard certificate.
#
# Backend is 10.10.20.1, the gateway's Servers-VLAN interface, deliberately not
# 192.168.0.1: both answer, but .1 on this subnet is one hop from the proxy and
# needs no inter-VLAN policy to keep working.
#
# UniFi OS presents a self-signed cert (CN=unifi.local, issued to itself), which
# is the entire reason for proxying it — proxy_ssl_verify off accepts it here, and
# the browser gets the real certificate for router.baig.network instead of a
# permanent warning you learn to click through.
#
# It is a single-page app with long-lived websockets for live stats, so it needs
# the Upgrade headers, buffering off, and a read timeout well past the default 60s
# or the UI drops its connection every minute.
server {
    listen 443 ssl;
    http2 on;
    server_name router.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    location / {
        proxy_pass https://10.10.20.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

