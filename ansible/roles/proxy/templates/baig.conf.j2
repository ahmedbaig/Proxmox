# Service register — the index of where everything lives.
# No longer default_server, and autoindex is off: it used to be both, so any
# unmatched hostname produced a directory listing of /var/www/hosts. That is
# now handled by the return 444 block below.
server {
    listen 443 ssl;
    http2 on;
    server_name home.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    include /etc/nginx/snippets/sso-auth.conf;
    root /var/www/hosts;
    index index.html;
    autoindex off;
    location / { try_files $uri $uri/ /index.html =404; }
}

