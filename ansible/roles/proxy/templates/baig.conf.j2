# /etc/nginx/conf.d/baig.conf  —  27 Sep 2026
#
# One certificate covers baig.network, *.baig.network and the per-VLAN levels
# *.servers, *.home, *.lab, *.iot and *.main. Every name below is served by it.
#
# Moving a service = change its proxy_pass line, reload. No DNS change needed:
# flat names all resolve to this container via AdGuard's *.baig.network rewrite.
#
# NOT PROXIED — connect directly
#   postgres   db.servers.baig.network:5432    user postgres
#   mariadb    db.servers.baig.network:3306    user ahmed (root is localhost-only)
#   mongodb    db.servers.baig.network:27017   user admin
#   redis      db.servers.baig.network:6379    no auth
#   couchdb    db.servers.baig.network:5984    also proxied as obsidian.baig.network
# The Mac mini's copies of these are STOPPED as of 27 Sep 2026; CT 112 is the
# only live set. Its data was verified identical: 723 tables, 22,661,265 rows.
#
# NOT PROXIED — no user interface worth exposing
#   node_exporter          :9100 on every host
#   blackbox_exporter      :9115 on metrics and pve
#   postgres/mysqld/redis  :9187 :9104 :9121 on db
#   mongodb/adguard        :9217 :9617 on apps
#   alloy                  :12345 on every host
# These are Prometheus scrape targets. See prometheus.yml on CT 114.
#
# PROXIED, BUT OUTSIDE THE NETWORK
#   gatus      oracle.baig.network -> http://158.178.143.215:80
#              Upstream is plain http over the internet: Oracle has no TLS and
#              there is no route from here into the tunnel. Direct link
#              http://158.178.143.215/ still works and is the fallback for when
#              the lab itself is unreachable.
#
# SELF-SIGNED BACKENDS — proxied so the browser sees the real certificate
#   pve        10.10.20.20:8006   Proxmox, its own CA
#   router     10.10.20.1:443     UniFi OS, CN=unifi.local
# Both use proxy_ssl_verify off. That is safe here and would not be on an
# untrusted path: it skips verifying the BACKEND's cert over a link that never
# leaves the Servers VLAN, while the client-facing side is fully verified.
#
# VPN endpoints (port forwards on the UX7, not nginx)
#   wireguard  udp/51820 -> 10.10.50.20   UI at wireguard.baig.network
#   openvpn    udp/1194  -> 192.168.0.3   kept indefinitely

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Who gets a helpful redirect, and who gets stonewalled.
#
# Unknown hostnames return 444 (close, no reply) because that tells a scanner
# nothing. But on the home network or over the VPN a wrong name is a typo, not an
# attack, and landing on the service register is more useful than a dead
# connection. So the behaviour is chosen by source address.
#
# tcp/443 is NOT forwarded on the UX7 today -- verified from the Oracle box
# straight at the WAN address, both 80 and 443 filtered -- so nothing outside can
# reach this at all right now. This is written by source anyway so it stays
# correct the day a forward is added and nobody remembers this file.
#
# 10.10.50.20 is the important entry and it is easy to get wrong: CT 116
# MASQUERADEs 10.9.0.0/24 out of eth0, so nginx sees the VPN CONTAINER, never the
# peer address. It is inside 10.10.0.0/16 below. 10.9.0.0/24 is listed only so
# this keeps working if that masquerade is ever removed.
geo $lab_client {
    default        0;
    10.10.0.0/16   1;   # every VLAN, including 10.10.50.20 (VPN egress)
    10.9.0.0/24    1;   # WireGuard peers directly, if masquerade is dropped
    192.168.0.0/25 1;   # Main Net
    127.0.0.0/8    1;   # the proxy itself, and blackbox probes
}

server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# Grafana — dashboards. Moved off the Mac mini to CT 115.
# The second Grafana (grafana-metrics, 10.3.3, port 3123) had zero
# dashboards and was removed; this instance carries all 14.
server {
    listen 443 ssl;
    http2 on;
    server_name grafana.baig.network;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;
    location / {
        proxy_pass http://10.10.20.7:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_verify off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

