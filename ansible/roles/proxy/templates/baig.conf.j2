# Catch-all for 443 — anything not matching a server_name above.
#
# From outside: 444, nginx's non-standard "close without replying", which tells a
# scanner nothing at all. Unchanged.
#
# From the lab or the VPN: 302 to the service register, because a name that does
# not exist here is a typo and a dead connection is a poor way to learn that.
#
# The redirect drops the path deliberately. The register is one page, so
# /some/deep/path carried over to it would only 404; sending everything to the
# root is the honest answer.
#
# KNOWN LIMIT, and it is the certificate's fault rather than this block's: the
# wildcard covers *.baig.network and *.<vlan>.baig.network, which is ONE extra
# label. A name like a.b.baig.network fails TLS verification before nginx ever
# sees the request, so no redirect can happen. AdGuard resolves those to this
# container quite happily, which makes it look like a proxy problem. It is not;
# it needs another SAN.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    ssl_certificate     /etc/nginx/ssl/baig.crt;
    ssl_certificate_key /etc/nginx/ssl/baig.key;

    if ($lab_client) {
        return 302 https://home.baig.network/;
    }
    return 444;
}
