    {
      "id": 16,
      "type": "stat",
      "title": "Driver",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nvidia_smi_up{host=\"jellyfin\"})"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "MISMATCH"
                },
                "1": {
                  "text": "OK"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "0 means nvidia-smi failed \u2014 usually a host kernel update left the CT's userspace driver on a different version. See the driver section of the Jellyfin doc."
    },
