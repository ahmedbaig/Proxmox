{
  "uid": "baig-files",
  "title": "Files and Jellyfin",
  "description": "CT 120 media share (Samba, FileBrowser at files.baig.network) and CT 121 Jellyfin reading it read-only with NVENC on the GTX 950.",
  "tags": [
    "baig",
    "files",
    "media"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Media used",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{host=\"files\",mountpoint=\"/srv/media\"} / node_filesystem_size_bytes{host=\"files\",mountpoint=\"/srv/media\"}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "DiskFillingUp fires below 10 % free. Until the media disk arrives this is a 40 GB thin volume on the NVMe."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Free",
      "gridPos": {
        "h": 4,
        "w": 4,
