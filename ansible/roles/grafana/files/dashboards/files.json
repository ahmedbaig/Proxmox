    {
      "id": 7,
      "type": "timeseries",
      "title": "Media space",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_size_bytes{host=\"files\",mountpoint=\"/srv/media\"} - node_filesystem_avail_bytes{host=\"files\",mountpoint=\"/srv/media\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "node_filesystem_size_bytes{host=\"files\",mountpoint=\"/srv/media\"}",
          "legendFormat": "size"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network (uploads in, Jellyfin reads out)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{host=\"files\",device=\"eth0\"}[5m])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{host=\"files\",device=\"eth0\"}[5m])",
          "legendFormat": "out"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
