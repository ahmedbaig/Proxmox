      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"unifi\"} |= \"STA_ASSOC_TRACKER\" != \"STA-TRACKER\" | regexp `(?P<payload>\\{.*\\})` | line_format \"{{.payload}}\" | json | event_type=~\".*(join|assoc|connect).*\" [$__range]))",
          "queryType": "instant"
