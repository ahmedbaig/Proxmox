{
  "uid": "baig-unifi",
  "title": "UniFi router",
  "tags": [
    "baig",
    "unifi",
    "network"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ident",
        "label": "Program",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "aen18i6tw61a8a"
        },
        "query": {
          "label": "ident",
          "stream": "{job=\"unifi\"}",
          "type": 1
        },
        "definition": "label_values({job=\"unifi\"}, ident)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Syslog receiving (5m)",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "aen18i6tw61a8a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"unifi\"}[5m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
