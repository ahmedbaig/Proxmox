{
  "uid": "baig-service-health",
  "title": "Service Health",
  "description": "Replaces the old internal.macmini.ahmedhome.com ping page. Every service probed over HTTPS, every host pinged, certificate expiry tracked, all from blackbox-exporter.",
  "tags": [
    "baig",
    "health",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(probe_success{job=\"blackbox-http\"})",
          "legendFormat": "up"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 19
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services down",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=\"blackbox-http\"} == 0) or vector(0)",
          "legendFormat": "down"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Certificate \u2014 days remaining",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min((probe_ssl_earliest_cert_expiry - time()) / 86400)",
          "legendFormat": "days"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "yellow",
                "value": 21
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Firing alerts",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 13,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "firing"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "DNS queries blocked",
      "gridPos": {
        "h": 4,
        "w": 7,
        "x": 17,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "adguard_num_blocked_filtering / adguard_num_dns_queries * 100",
          "legendFormat": "blocked %"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Every service \u2014 status, response code and certificate expiry",
      "description": "probe_success is the authority on whether a service is up. HTTP 401 and 403 are healthy for services that require auth (CouchDB, Plex, mongo-express, Transmission) \u2014 the blackbox module counts them as success deliberately.",
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox-http\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "probe_http_status_code{job=\"blackbox-http\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "probe_duration_seconds{job=\"blackbox-http\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "site": true
            },
            "renameByName": {
              "instance": "Service",
              "Value #A": "Up",
              "Value #B": "HTTP",
              "Value #C": "Cert days",
              "Value #D": "Response"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Up"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cert days"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "yellow",
                      "value": 21
                    },
                    {
                      "color": "green",
                      "value": 30
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Response"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Host reachability (ICMP)",
      "description": "Probed from the Proxmox host, not the metrics container: an unprivileged LXC cannot open raw sockets. Only 192.168.0.1 is reachable on Main Net from the Servers VLAN \u2014 the Pi, AP and switch are blocked by firewall zoning and are deliberately not probed.",
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 14,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox-icmp\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "probe_duration_seconds{job=\"blackbox-icmp\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "site": true
            },
            "renameByName": {
              "instance": "Host",
              "Value #A": "Reachable",
              "Value #B": "RTT"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reachable"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NO",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "yes",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RTT"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Service response time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fen19il3pklq8c"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"blackbox-http\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Log volume by host",
      "description": "Lines per second arriving in Loki. A host dropping to zero means its Alloy agent has stopped, which is worth noticing before you need the logs.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "loki",
        "uid": "aen18i6tw61a8a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate({job=~\"systemd-journal|docker\"}[5m]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        }
      }
    }
  ]
}